# All variables are optional for local development. Real values belong in
# .env.local (git-ignored via `.env*`) or in the Vercel project settings.
# Never prefix any of these with NEXT_PUBLIC_.

# Server-only. Stripe Payment Link that /donate redirects to (https only).
# If unset or not https, /donate answers 500 instead of redirecting.
# STRIPE_SUPPORT_LINK_URL=https://buy.stripe.com/test_xxxxxxxx

# Server-only. Optional GitHub token; lifts the unauthenticated rate limit on
# the public repos and public events requests. No scopes needed.
# GITHUB_TOKEN=ghp_placeholder

# Server-only. Webmaster verification meta tags. Unset omits the tag.
# Google Search Console, Yandex Webmaster, Bing Webmaster (msvalidate.01).
# GOOGLE_SITE_VERIFICATION=placeholder-token
# YANDEX_VERIFICATION=placeholder-token
# BING_SITE_VERIFICATION=placeholder-token

# Set by Vercel at build/run time; read by /api/health and instrumentation.ts.
# Leave unset locally ("local" is reported instead).
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_REGION=
# GITHUB_SHA=

# --- Portfolio Ask (Embedded RAG) ---
# Server-only. Neon Postgres with the pgvector extension. Used by /api/ask,
# /api/rag-sources, and `npm run rag:seed`. Either name works.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# POSTGRES_URL=

# Server-only. Anthropic API key for the Ask generation step.
# ANTHROPIC_API_KEY=

# Optional Ask knobs (defaults match Fors-Corp/embedded-rag).
# CHAT_MODEL=claude-sonnet-5-5
# TOP_K=4
# MAX_DISTANCE=0.65
# MAX_QUESTION_CHARS=2000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# Optional shared secret for /api/ask and /api/rag-sources (x-rag-secret or Bearer).
# RAG_ASK_SECRET=
# TRANSFORMERS_CACHE=/tmp/transformers-cache
# EMBED_DEVICE=cpu
