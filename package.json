{
  "name": "marcfors.com",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prebuild": "node scripts/gen-tokens.mjs && node scripts/audit-snapshot.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "privacy": "node scripts/check-privacy.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run privacy && npm run test:coverage && npm run typecheck && npm run lint && npm run audit && npm run build",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pretest:e2e": "next build"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.35.0",
    "web-vitals": "^6.2.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "toml": "^5.0.0"
  }
}
