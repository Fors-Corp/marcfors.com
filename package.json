{
  "name": "marcfors.com",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/gen-tokens.mjs && node scripts/audit-snapshot.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "rag:seed": "tsx scripts/rag/seed.ts",
    "rag:extract-cv": "tsx scripts/rag/extract-cv-cli.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "privacy": "node scripts/check-privacy.mjs",
    "cv:update": "node scripts/update-cv-contributions.mjs",
    "audit": "node scripts/run-audit.mjs",
    "ci": "npm run privacy && npm run test:coverage && npm run typecheck && npm run lint && npm run audit && npm run build",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pretest:e2e": "next build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mdx-js/react": "^3.1.1",
    "@napi-rs/canvas": "^1.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.36.0",
    "web-vitals": "^6.2.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^10",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "toml": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true
  }
}
